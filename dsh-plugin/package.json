{
  "name": "@forge3d/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge3D canvas inside DeepSeek Harness: a conversation.view tab that hosts the existing Forge3D web app.",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
