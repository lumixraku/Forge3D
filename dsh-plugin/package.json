{
  "name": "@forge3d/dsh-plugin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Build 3D asset workflows on a node canvas from the DeepSeek conversation: prompt or reference image to model, UV texture, and export.",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "migrations",
    "runtime"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "dsh-plugin",
    "forge3d",
    "3d",
    "canvas",
    "meshy",
    "tripo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge3d/forge3d.git",
    "directory": "dsh-plugin"
  }
}
