{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@forge3d/canvas-core": [
        "packages/canvas-core/src/index.ts"
      ]
    }
  },
  "include": [
    "worker.ts",
    "server/**/*.ts",
    "packages/**/*.ts"
  ]
}
