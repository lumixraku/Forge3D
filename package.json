{
  "name": "forge3d",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "NO_PROXY=\"${NO_PROXY:-127.0.0.1,localhost}\" node --use-env-proxy --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "server": "NO_PROXY=\"${NO_PROXY:-127.0.0.1,localhost}\" node --use-env-proxy --env-file-if-exists=.env --import tsx server/index.ts",
    "agent:service": "NO_PROXY=\"${NO_PROXY:-127.0.0.1,localhost}\" node --use-env-proxy --env-file-if-exists=.env --watch --import tsx agent-service/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --noCheck && tsc --noEmit -p tsconfig.app.json",
    "cf:build": "npm run build",
    "cf:deploy": "unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy && npm run build && node scripts/prepare-cloudflare-assets.mjs && npx wrangler deploy",
    "cf:d1:migrate": "unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy && npx wrangler d1 migrations apply forge3d --remote",
    "cf:release": "npm run test && npm run cf:d1:migrate && npm run cf:deploy",
    "test": "node --env-file-if-exists=.env --import tsx --test server/*.test.ts src/*.test.js packages/*/src/*.test.js",
    "test:postgres": "TEST_DATABASE_URL=postgresql://forge3d:forge3d@127.0.0.1:5432/forge3d node --import tsx --test server/postgres-store.test.ts server/postgres-http.test.ts",
    "agent:eval": "node --import tsx --test server/agent-eval.test.ts",
    "build:plugin": "npm run build:plugin-server && vite build --config vite.config.plugin.ts",
    "watch:plugin": "vite build --watch --config vite.config.plugin.ts",
    "build:plugin-server": "esbuild dsh-plugin/server-entry.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@forge3d/canvas-core=./packages/canvas-core/src/index.ts --outfile=dsh-plugin/lib/server.bundle.mjs",
    "dev:plugin": "concurrently -k \"esbuild dsh-plugin/server-entry.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dsh-plugin/lib/server.bundle.mjs --watch\" \"vite build --config vite.config.plugin.ts --watch\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.0",
    "@earendil-works/pi-ai": "^0.82.0",
    "@google/model-viewer": "^4.3.1",
    "@msgpack/msgpack": "^3.1.3",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "dompurify": "^3.4.12",
    "elkjs": "^0.11.1",
    "litegraph.js": "^0.7.18",
    "marked": "^18.0.7",
    "pg": "^8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.0",
    "postcss": "8.5.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  }
}
